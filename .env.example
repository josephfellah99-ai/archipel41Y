# ============================================================================
#  ARCHIPEL41 – configuration du serveur central (copier en « .env »)
#  Ne JAMAIS inscrire de clé API ici : les clés des services d'IA se saisissent
#  dans l'application (Paramètres › Intelligence artificielle), chiffrées en base.
# ============================================================================

# development | production
ARCHIPEL_ENV=production
ARCHIPEL_MODE=server

# Base de données PostgreSQL (PostGIS + pgvector) – voir docker-compose.yml
POSTGRES_DB=archipel41
POSTGRES_USER=archipel
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long-et-aleatoire
ARCHIPEL_DATABASE_URL=postgresql+psycopg://archipel:changez-moi-mot-de-passe-long-et-aleatoire@db:5432/archipel41

# Clé de signature des sessions : générer avec  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (laisser vide : une clé aléatoire est créée et conservée dans le dossier de données)
ARCHIPEL_SECRET_KEY=

# Dossier des données (fichiers, sauvegardes, journaux) dans le conteneur
ARCHIPEL_DATA_DIR=/data

# Écoute HTTP du serveur (placer un proxy HTTPS devant – voir docker-compose.yml)
ARCHIPEL_HOST=0.0.0.0
ARCHIPEL_PORT=8041

# Origines autorisées (CORS) si l'interface est servie depuis un autre domaine ; vide = même origine uniquement
ARCHIPEL_CORS_ORIGINS=

# Durée de validité d'une session (minutes)
ARCHIPEL_ACCESS_TOKEN_MINUTES=720

# Taille maximale d'un fichier importé (Mo)
ARCHIPEL_MAX_UPLOAD_MB=200

# Nom de domaine public (certificat HTTPS automatique par Caddy)
ARCHIPEL_DOMAIN=archipel41.example.fr
